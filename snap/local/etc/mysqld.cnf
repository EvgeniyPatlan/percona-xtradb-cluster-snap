#
# Percona XtraDB Cluster Configuration
#
# For a full list of available options and explanations, see:
# https://dev.mysql.com/doc/refman/en/server-system-variables.html
# https://docs.percona.com/percona-server/
#

#
# * General Settings
#
[mysqld]
pid-file            = /var/snap/_NAME_/current/run/mysqld.pid
socket              = /var/snap/_NAME_/current/run/mysqld.sock
datadir             = /var/snap/_NAME_/common/data
secure-file-priv    = NULL
bind-address        = 127.0.0.1
port                = 3306
mysqlx-bind-address = 127.0.0.1
mysqlx-port         = 33060
mysqlx-socket       = /var/snap/_NAME_/current/run/mysqlx.sock

#
# * Fine Tuning
#
key_buffer_size        = 16M
myisam-recover-options = BACKUP
# max_allowed_packet   = 64M
# thread_stack         = 256K
# thread_cache_size    = -1
# max_connections      = 151
# table_open_cache     = 4000

#
# * Logging and Replication
#
# Log all queries
# Be aware that this log type is a performance killer.
# general_log_file = /var/snap/_NAME_/current/log/query.log
# general_log      = 1

# Error log - should be very few entries.
log_error = /var/snap/_NAME_/current/log/error.log

# Here you can see queries with especially long duration
# slow_query_log      = 1
# slow_query_log_file = /var/snap/_NAME_/current/log/mysql-slow.log
# long_query_time     = 2
# log-queries-not-using-indexes

# The following can be used as easy to replay backup logs or for replication.
# server-id                  = 1
# log_bin                    = /var/snap/_NAME_/current/log/mysql-bin.log
# binlog_expire_logs_seconds = 2592000
max_binlog_size              = 100M
# binlog_do_db               = include_database_name
# binlog_ignore_db           = include_database_name

#
# * Galera cluster membership
#
# To JOIN this node to an existing cluster, set the cluster address to the
# other nodes' Galera ports and restart the service
# (snap restart _NAME_.mysqld). Note: cluster traffic encryption is ON by
# default; every node must share the SSL certificates auto-generated in the
# first node's data directory (/var/snap/_NAME_/common/data/*.pem).
# IMPORTANT: a node that should REJOIN an existing cluster must have wsrep_cluster_address set BEFORE it is restarted; otherwise it bootstraps a new single-node cluster.
# [mysqld]
# wsrep_cluster_address = gcomm://10.0.0.1:4567,10.0.0.2:4567
# wsrep_node_address    = <this node's IP>
# wsrep_node_name       = <unique node name>
