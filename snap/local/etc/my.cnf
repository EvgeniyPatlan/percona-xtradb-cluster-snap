# Default server settings
[mysqld]
pid-file            = /var/snap/_NAME_/current/run/mysqld.pid
socket              = /var/snap/_NAME_/current/run/mysqld.sock
datadir             = /var/snap/_NAME_/common/data
secure-file-priv    = NULL
user                = snap_daemon
bind-address        = 127.0.0.1
mysqlx-bind-address = 127.0.0.1
mysqlx-socket       = /var/snap/_NAME_/current/run/mysqlx.sock

# The Percona telemetry agent is not shipped in this snap; keep the
# server-side telemetry component disabled if it ever gets loaded.
# loose- prefix: the variable only exists when the component is loaded.
loose-percona_telemetry_disable = 1

# Galera clustering. An empty gcomm:// bootstraps a new single-node
# cluster on every fresh start; set wsrep_cluster_address in
# /var/snap/_NAME_/current/etc/mysqld.cnf to join an existing cluster.
wsrep_provider        = /snap/_NAME_/current/usr/lib/galera4/libgalera_smm.so
wsrep_cluster_address = gcomm://
wsrep_cluster_name    = pxc-cluster
wsrep_sst_method      = xtrabackup-v2
binlog_format         = ROW

# Import all .cnf files from configuration directory
!includedir /var/snap/_NAME_/current/etc
