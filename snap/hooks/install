#!/bin/bash

init_snap_data() {
    # Configuration
    mkdir $SNAP_DATA/etc
    cp $SNAP/etc/mysqld.cnf $SNAP_DATA/etc

    # Defaults file for the clustercheck health probe. Written BEFORE the
    # chown -R below (not after): under strict/jailmode confinement, once a
    # directory has been handed off via chown, root can no longer create a
    # new file inside it (CI-proven: "line 10: .../clustercheck.cnf:
    # Permission denied" then "chown: cannot dereference ...: No such file
    # or directory" when this heredoc ran after the chown -R handoff).
    # Populate every file in $SNAP_DATA/etc first, then hand the whole tree
    # off with a single chown -R.
    cat <<EOF > $SNAP_DATA/etc/clustercheck.cnf
[client]
user   = root
socket = $SNAP_DATA/run/mysqld.sock
EOF

    chown -R snap_daemon:root $SNAP_DATA/etc

    # Logs
    mkdir $SNAP_DATA/log
    touch $SNAP_DATA/log/error.log
    touch $SNAP_DATA/log/query.log
    touch $SNAP_DATA/log/mysql-bin.log
    touch $SNAP_DATA/log/mysql-slow.log
    chown -R snap_daemon:root $SNAP_DATA/log

    # Sockets
    mkdir $SNAP_DATA/run
    chown -R snap_daemon:root $SNAP_DATA/run
}

init_snap_common() {
    # Create directory for storing data and set permissions.
    #
    # NOTE: this path is touched twice (chown here, chmod below) which
    # looks like the same "one post-creation mutating op per path" issue
    # fixed above for clustercheck.cnf (and elsewhere in sibling snaps by
    # folding the mode into `mkdir -m`). That fold was tried here first and
    # is a CI-proven regression for this specific path: with the mode set
    # via `mkdir -m 0700` (chmod dropped), `mysqld --initialize` no longer
    # produced mysql.ibd on any of 13/13 spread tasks, on both amd64 and
    # arm64 (mysqld's own diagnostics go to $SNAP_DATA/log/error.log, not
    # captured hook output, so the exact mechanism isn't visible from CI
    # logs). The original chown-then-chmod form below is CI-proven to let
    # --initialize succeed every time; the chmod's own exit status was
    # never checked, so if it is silently denied the directory is left
    # world-readable rather than restricted to snap_daemon -- a latent
    # hardening gap, not an install failure. See pxc-ci-fix-report.md for
    # detail. Follow the logs: keep the working shape here.
    mkdir $SNAP_COMMON/data
    chown snap_daemon:root $SNAP_COMMON/data

    # Initialize data directory
    $SNAP/bin/setpriv.sh $SNAP/usr/sbin/mysqld \
        --defaults-file=$SNAP/etc/my.cnf \
        --wsrep-provider=none \
        --user=root \
        --initialize

    # Throw error if data directory not initialized
    if [ ! -f $SNAP_COMMON/data/mysql.ibd ] ; then
        echo "Error: MySQL was unable to initialize the data directory at $SNAP_COMMON/data" >&2
        exit 1
    fi

    # Remove "group" and "other" permission access from data directory
    chmod go-rwx $SNAP_COMMON/data
}

enable_auth_socket() {
    local init_file="$(mktemp)"

    echo "INSTALL PLUGIN auth_socket SONAME 'auth_socket.so';" >> "$init_file"
    echo "ALTER USER 'root'@'localhost' IDENTIFIED WITH 'auth_socket';" >> "$init_file"
    echo "SHUTDOWN;" >> "$init_file"
    chown snap_daemon:root "$init_file"

    # Run init file
    $SNAP/bin/setpriv.sh $SNAP/usr/sbin/mysqld \
        --defaults-file=$SNAP/etc/my.cnf \
        --wsrep-provider=none \
        --user=snap_daemon \
        --skip-networking \
        --skip-mysqlx \
        --init-file="$init_file"
}

init_snap_data
init_snap_common
enable_auth_socket
